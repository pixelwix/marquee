# ---- Server ----
PORT=4000
SESSION_SECRET=change-me-to-a-long-random-string
PUBLIC_URL=https://media.example.com
# Bare hostname (no scheme) that docker-compose.yml's Traefik label routes to —
# should match PUBLIC_URL's host. Left unset, the container's Traefik router
# falls back to a placeholder domain that matches nothing, so the site is
# simply unreachable rather than accidentally exposed under the wrong name.
MARQUEE_DOMAIN=media.example.com
# Shown as the page title/wordmark. Defaults to "Marquee" if unset — set this to
# brand your own deployment (e.g. SITE_NAME=MyPlexHub).
SITE_NAME=Marquee
# Optional, pipe-separated. Cycles on the sign-in screen and shows one (picked at
# random per page load) as a small caption under the dashboard's own logo. Defaults
# to a single generic phrase if unset — give it your own personality, e.g. for a
# Skynet-named site: SITE_TAGLINES=Always watching.|Learning your patterns.|I'll be back with recommendations.
SITE_TAGLINES=
# Overrides the docker container's name (defaults to "marquee"). Only matters if you
# want a specific name in `docker ps`/your log viewer.
CONTAINER_NAME=marquee
# Host-side port for docker-compose (container always listens on 4000 internally).
# Point your reverse proxy/tunnel at this. Defaults to 4000 if unset.
HOST_PORT=4000
# Only mark this true once you're actually accessing the app over HTTPS (i.e. through
# a reverse proxy). Testing directly at http://host:4000 needs this OFF, or the
# browser silently refuses to store the session cookie.
COOKIE_SECURE=false
# Base directory for every SQLite file the app writes (sessions, logins, alerts,
# notice, push subscriptions, stream origins, recap send log, disk-space history,
# audit log, and the on-disk image cache below). Defaults to /app/data if unset —
# only matters if you're running outside the standard docker-compose volume mount.
SESSION_DB_DIR=/app/data

# ---- Plex (used for "Sign in with Plex" + Now Playing) ----
# Admin/owner token for YOUR plex server (Settings > ... or see Plex support docs "Finding an authentication token")
PLEX_ADMIN_TOKEN=
# Your Plex server's machine identifier (Settings > General, or from /identity endpoint)
PLEX_MACHINE_ID=
PLEX_SERVER_URL=http://localhost:32400
# A stable random UUID identifying this app to plex.tv (generate once, keep forever)
PLEX_CLIENT_ID=marquee-app-a1b2c3d4
# The /img route (see lib/mediaCache.js) caches Plex thumb/art images on disk so
# the browser never talks to Plex directly. Both optional: IMAGE_CACHE_DIR
# defaults to <SESSION_DB_DIR>/image-cache, IMAGE_CACHE_MAX_BYTES defaults to 1GB
# (oldest entries pruned once the cache exceeds it).
IMAGE_CACHE_DIR=
IMAGE_CACHE_MAX_BYTES=

# ---- Tautulli ----
TAUTULLI_URL=http://localhost:8181
TAUTULLI_API_KEY=
# Optional: split "Recently Added" into sections instead of one combined list.
# Find section IDs by hitting GET /api/tautulli/libraries once signed in.
TAUTULLI_SECTION_MOVIES=
TAUTULLI_SECTION_TV=
TAUTULLI_SECTION_ANIME=

# Monthly recap email delivery through Tautulli's Email notification agent.
# Marquee must resubmit the complete notifier configuration for each recipient,
# so these values need to mirror the notifier's SMTP settings in Tautulli.
TAUTULLI_EMAIL_NOTIFIER_ID=
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_TLS=1
EMAIL_FROM=
EMAIL_FROM_NAME=

# ---- Sonarr ----
SONARR_URL=http://localhost:8989
SONARR_API_KEY=

# ---- Radarr ----
RADARR_URL=http://localhost:7878
RADARR_API_KEY=

# ---- Overseerr / Jellyseerr ----
OVERSEERR_URL=http://localhost:5055
OVERSEERR_API_KEY=
# Powers the "Available now" toast. Generate a random string, put it here, then in
# Overseerr: Settings -> Notifications -> Webhook -> enable, Webhook URL =
# <PUBLIC_URL>/api/overseerr/webhook, Authorization Header = the same string, JSON
# Payload = leave as the default template. Only the "Request Available" notification
# type needs to be checked.
OVERSEERR_WEBHOOK_SECRET=
# Optional: if Overseerr's webhook was already pointed somewhere else before adding
# OVERSEERR_WEBHOOK_SECRET above (Overseerr only supports one webhook URL at a time),
# put that original URL here and every payload gets forwarded on unchanged so nothing
# else that relied on it breaks.
OVERSEERR_WEBHOOK_FORWARD_URL=

# ---- Prowlarr (owner-only indexer health on the admin page) ----
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=

# ---- Download Queue (both optional — leave a section's URL blank to skip it) ----
# qBittorrent >= 5.2.0 (WebAPI >= 2.14.1) supports real API-key auth — set
# QBITTORRENT_API_KEY (WebUI → Settings → General) and leave USERNAME/PASSWORD
# blank to use it instead. On older versions, or if API_KEY is left blank,
# this falls back to a real WebUI login. If "bypass auth for whitelisted
# subnet" is on, that only covers requests that keep your LAN source IP —
# container-to-container traffic usually doesn't, so a real login/API key is
# still needed here either way.
QBITTORRENT_URL=http://localhost:9080
QBITTORRENT_API_KEY=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
# Settings → General → check "API Key" in SABnzbd's web UI
SABNZBD_URL=http://localhost:8080
SABNZBD_API_KEY=

# ---- Owner-only status panel (optional — only shown to the server owner, never
# shared users). Leave blank to skip a source entirely. ----
# Uptime Kuma's data directory on the HOST (used by docker-compose.yml's volume
# mount) and the matching path INSIDE the container (used by the app) — both
# needed together.
UPTIME_KUMA_DATA_DIR=
UPTIME_KUMA_DB_PATH=/app/uptime-kuma-data/kuma.db
# Powers the /api/uptime-kuma/webhook receiver — generate a random string, put it
# here, then in Uptime Kuma: Settings -> Notifications -> add "Webhook", Post URL =
# <PUBLIC_URL>/api/uptime-kuma/webhook?secret=<this value>, apply it to every
# monitor. Down/up events feed straight into the Alerts panel instead of a
# separate notification channel.
UPTIME_KUMA_WEBHOOK_SECRET=
# Directory on the HOST containing your NAS's media share mounts, one
# subdirectory per share (used by docker-compose.yml's volume mount). Powers
# the Disk Space panel's real physical-volume data instead of Radarr/Sonarr's
# own diskspace API. Leave blank to skip — falls back to Radarr/Sonarr.
MEDIA_MOUNT_DIR=
# Directory on the HOST holding Kometa's config (used by docker-compose.yml's
# volume mount). When set, posting or clearing the notice board also
# writes/removes a small collection YAML there, so Kometa mirrors the notice
# onto the Plex Home screen on its next scheduled run. Leave blank to skip —
# the notice board still works, it just stays Marquee-only.
KOMETA_CONFIG_DIR=
# Speaks NUT's (Network UPS Tools) protocol directly — this is whatever host runs
# upsd, not necessarily this Docker host. NUT_UPS_NAME is the device name as NUT
# knows it (`LIST UPS` on upsd, or check your NUT web UI if you have one).
NUT_HOST=
NUT_PORT=3493
NUT_USERNAME=
NUT_PASSWORD=
NUT_UPS_NAME=

# ---- Arr-stack health watchdog (external cron script — see
# /mnt/docker/scripts/arr-health-watchdog.mjs on docker-host) ----
# Shared secret the watchdog sends as a raw Authorization header value (same
# pattern as OVERSEERR_WEBHOOK_SECRET above, not a "Bearer <token>" scheme) —
# generate a random string and put the identical value in both places.
ALERTS_INGEST_SECRET=

# ---- Web Push (optional — pings a subscribed device the moment something
# worth knowing happens, even without the dashboard open: the owner gets
# stack alerts (routes/alerts.js's ingest reconciliation) and new-request
# pings, any signed-in family member can turn on "your request is available"
# notifications for their own requests — see lib/pushNotify.js's
# notifyOwners()/notifyUser()). Generate a key pair once with
# `node -e "console.log(require('web-push').generateVAPIDKeys())"` and never
# change it afterward — existing subscriptions are tied to it. Leave blank to
# skip; the notification bell just won't appear on either page. VAPID_SUBJECT
# is a contact URI push services may use to reach you about this key, e.g.
# mailto:you@example.com.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---- CLIProxyAPI (optional — powers the Alerts panel's "Suggest fix" button on
# log-triage/import-stuck alerts; see lib/cliproxyClient.js). Self-hosted OpenAI/
# Anthropic-compatible proxy backed by a subscription, not metered per-call. Plain
# text generation only — this feature has no ability to execute anything, it only
# suggests what to check. Leave blank to skip; the button just won't appear.
CLIPROXY_URL=
CLIPROXY_API_KEY=
# Optional: overrides the Antigravity model tried first, before the Claude
# fallback above (see lib/cliproxyClient.js's completeWithAntigravity). Uses the
# same CLIPROXY_URL/CLIPROXY_API_KEY above — Antigravity shares that OAuth quota,
# it's not a separate free tier. Defaults to gemini-3.1-flash-lite if unset.
ANTIGRAVITY_MODEL=

# ---- Privacy & Visibility (optional — controls what non-owner family members
# see of EACH OTHER in Now Playing / Top of the Month; see lib/privacy.js. The
# owner always sees everything, and everyone always sees their own stream/
# stats in full regardless of these settings. Managed from Settings -> Privacy
# & Visibility in the admin UI, not usually hand-edited here. Leave blank for
# the fully-open default (nothing hidden).
PRIVACY_STREAM_USER_IDENTITY=
PRIVACY_STREAM_MEDIA_CONTENT=
PRIVACY_STREAM_TECHNICAL=
PRIVACY_STATS=

# ---- Stream Origins server location (optional — see lib/streamOrigins.js). When
# set, the admin Stream Origins map draws an arc from every real viewer location to
# this point instead of plain heat-point dots — set it once to wherever the server
# actually is (decimal degrees, e.g. SERVER_LAT=44.9778, SERVER_LON=-93.2650).
# Leave both blank to keep the original heat-point map with no arcs.
SERVER_LAT=
SERVER_LON=
