#!/usr/bin/env bash
# Blocks commits that introduce private/internal IP addresses (RFC1918 ranges)
# into tracked files. This repo is public — .env.example has leaked real LAN
# IPs into it before. Actual config/secrets belong only in .env, which is
# gitignored; anything tracked (README, .env.example, etc.) should use
# localhost or an example.com-style placeholder instead.
set -euo pipefail

pattern='\b(10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}|172\.(1[6-9]|2[0-9]|3[0-1])\.[0-9]{1,3}\.[0-9]{1,3}|192\.168\.[0-9]{1,3}\.[0-9]{1,3})\b'

hits=$(git diff --cached -U0 -- . ':(exclude).env' \
  | grep -E '^\+' | grep -Ev '^\+\+\+' | grep -E "$pattern" || true)

if [ -n "$hits" ]; then
  echo "pre-commit: private/internal IP address(es) found in staged changes:"
  echo "$hits"
  echo
  echo "This repo is public — real LAN IPs shouldn't be committed (use 'localhost'"
  echo "or an example.com-style placeholder instead)."
  echo "If this is genuinely intentional, commit with --no-verify."
  exit 1
fi
